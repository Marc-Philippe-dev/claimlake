# Copy to .env (never commit .env).
# Keep comments on their own lines and no spaces around "=".

# Policy administration system (PAS) database. Light profile: SQLite.
PAS_DB_URL=sqlite:///data/pas.db
# Full profile (SQL Server in Docker, requires pymssql):
# PAS_DB_URL=mssql+pymssql://sa:<SA_PASSWORD>@localhost:1433/pas

CLAIMSLAKE_ROOT=data
CLAIMSLAKE_FNOL_SOURCE=files
SPARK_MASTER=local[2]
SPARK_LOCAL_IP=127.0.0.1